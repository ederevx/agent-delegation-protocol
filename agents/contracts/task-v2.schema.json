{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ederevx/agent-delegation-protocol/agents/contracts/task-v2.schema.json",
  "title": "Delegation task v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "mode", "repo", "prompt", "allowed_paths", "workspace", "validation", "budgets"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mode": {"enum": ["read", "edit"]},
    "repo": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 49152},
    "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.git(?:[\\\\/]|$)).+$"}},
    "workspace": {"enum": ["shared", "isolated"]},
    "validation": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "max_input_tokens", "max_output_tokens", "max_output_bytes", "max_steps"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_output_bytes": {"type": "integer", "minimum": 1},
        "max_steps": {"type": "integer", "minimum": 1}
      }
    }
  }
}
