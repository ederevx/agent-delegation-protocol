{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ederevx/agent-delegation-protocol/agents/contracts/deployment-v1.schema.json",
  "title": "Agent-neutral managed deployment v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "selector", "provider", "credential", "gateway", "resources", "service", "runtime", "inference", "execution"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimes", "platforms", "modes", "workspaces", "functions", "priority"],
      "properties": {
        "runtimes": {"$ref": "#/$defs/stringSet"}, "platforms": {"$ref": "#/$defs/stringSet"},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read", "edit"]}},
        "workspaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["shared", "isolated"]}},
        "functions": {"$ref": "#/$defs/stringSet"}, "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "provider": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}},
    "credential": {"type": "object", "additionalProperties": false, "required": ["kind", "reference"], "properties": {"kind": {"const": "protocol_store"}, "reference": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"}}},
    "gateway": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream", "allowed_methods", "allowed_paths", "credential_header", "credential_scheme", "resource", "timeout_seconds"],
      "properties": {
        "upstream": {"type": "string", "pattern": "^https?://"},
        "allowed_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["POST", "GET", "PUT", "PATCH", "DELETE"]}},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "credential_header": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}, "credential_scheme": {"type": "string"},
        "resource": {"type": "string", "minLength": 1}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "resources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "capacity", "lease_seconds", "wait_seconds"], "properties": {"id": {"type": "string", "minLength": 1}, "capacity": {"type": "integer", "minimum": 1}, "lease_seconds": {"type": "integer", "minimum": 1}, "wait_seconds": {"type": "integer", "minimum": 1}}}},
    "service": {"type": "object", "additionalProperties": false, "required": ["idle_seconds", "max_clients", "max_dependency_seconds", "retention_probe_seconds"], "properties": {"idle_seconds": {"type": "integer", "minimum": 1}, "max_clients": {"type": "integer", "minimum": 1}, "max_dependency_seconds": {"type": "integer", "minimum": 1}, "retention_probe_seconds": {"type": "integer", "minimum": 1}}},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "executable", "session", "environment", "arguments"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "executable": {"type": "object", "additionalProperties": false, "required": ["command", "environment"], "properties": {"command": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}}},
        "session": {"type": "object", "additionalProperties": false, "required": ["config_dir", "environment", "max_agents", "permission_mode"], "properties": {"config_dir": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["posix", "windows"], "properties": {"posix": {"type": "string", "minLength": 1}, "windows": {"type": "string", "minLength": 1}}}]}, "environment": {"type": "string", "minLength": 1}, "max_agents": {"type": "integer", "minimum": 1}, "permission_mode": {"type": "string", "minLength": 1}}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}, "arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "inference": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "thinking", "worker_effort", "interactive_effort", "context_tokens", "max_output_tokens"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "thinking": {
          "type": "object", "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["adaptive", "enabled", "disabled"]},
            "budget_tokens": {"type": "integer", "minimum": 1}
          },
          "if": {"properties": {"type": {"const": "enabled"}}},
          "then": {"required": ["type", "budget_tokens"]},
          "else": {"not": {"required": ["budget_tokens"]}}
        },
        "worker_effort": {"enum": ["low", "medium", "high", "xhigh", "max"]}, "interactive_effort": {"enum": ["unset", "auto", "low", "medium", "high", "xhigh", "max"]},
        "context_tokens": {"type": "integer", "minimum": 1}, "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 131072}
      }
    },
    "execution": {"type": "object", "additionalProperties": false, "required": ["workspace_engine", "evidence", "permission_policy"], "properties": {"workspace_engine": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}, "permission_policy": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"stringSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
