{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ederevx/agent-delegation-protocol/agents/contracts/request-v2.schema.json",
  "title": "Delegation scheduler request v2",
  "oneOf": [
    {"$ref": "#/$defs/run"},
    {"$ref": "#/$defs/batch"},
    {"$ref": "#/$defs/resume"}
  ],
  "$defs": {
    "selector": {
      "type": "object",
  "required": ["schema_version", "route", "tier", "runtime", "platform", "function", "mode", "workspace"],
      "properties": {
        "schema_version": {"const": 2},
    "route": {"type": "string", "minLength": 1},
    "tier": {"enum": ["low", "balanced", "parent"]},
        "runtime": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1},
        "mode": {"enum": ["read", "edit"]},
        "workspace": {"enum": ["shared", "isolated"]}
      }
    },
    "run": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/selector"},
        {"type": "object", "required": ["task"], "properties": {"task": {"$ref": "task-v2.schema.json"}}}
      ]
    },
    "batch": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/selector"},
        {"type": "object", "required": ["tasks"], "properties": {"tasks": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "task-v2.schema.json"}}}}
      ]
    },
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "backend", "token", "resolution"],
      "properties": {
        "schema_version": {"const": 2},
        "backend": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1},
        "resolution": {"type": "object"}
      }
    }
  }
}
