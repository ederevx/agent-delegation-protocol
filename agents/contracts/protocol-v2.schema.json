{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ederevx/agent-delegation-protocol/agents/contracts/protocol-v2.schema.json",
  "title": "Agent delegation protocol v2 catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tiers", "backends", "routes"],
  "properties": {
    "schema_version": {"const": 2},
    "tiers": {
      "type": "object", "additionalProperties": false,
      "required": ["low", "balanced", "parent"],
      "properties": {
        "low": {"$ref": "#/$defs/tierLimits"},
        "balanced": {"$ref": "#/$defs/tierLimits"},
        "parent": {"$ref": "#/$defs/tierLimits"}
      }
    },
    "backends": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/backend"}},
    "routes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}},
    "includes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stringSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "tierLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_input_tokens", "max_output_tokens"],
      "properties": {
        "max_input_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "tier", "selector", "availability", "execution"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["native", "oneshot", "session"]},
        "tier": {"enum": ["low", "balanced", "parent"]},
        "selector": {
          "type": "object", "additionalProperties": false,
          "required": ["runtimes", "platforms", "modes", "workspaces", "functions"],
          "properties": {
            "runtimes": {"$ref": "#/$defs/stringSet"},
            "platforms": {"$ref": "#/$defs/stringSet"},
            "modes": {"$ref": "#/$defs/stringSet"},
            "workspaces": {"$ref": "#/$defs/stringSet"},
            "functions": {"$ref": "#/$defs/stringSet"}
          }
        },
        "availability": {
          "type": "object", "additionalProperties": false,
          "required": ["commands", "environment"],
          "properties": {
            "commands": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "environment": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["delivery"],
          "properties": {
            "delivery": {"enum": ["native", "json", "managed"]},
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "deployment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
            "timeout_seconds": {"type": "integer", "minimum": 1},
            "max_steps": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        "lane": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "max_concurrency", "lease_seconds"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "max_concurrency": {"type": "integer", "minimum": 1},
            "lease_seconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
