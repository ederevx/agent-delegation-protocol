{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ederevx/agent-delegation-protocol/agents/contracts/cooperative-v1.schema.json",
  "title": "Delegation cooperative adapter protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["schema_version", "adapter_protocol", "operation"],
      "properties": {
        "schema_version": { "const": 1 },
        "adapter_protocol": { "const": "cooperative-v1" },
        "operation": { "enum": ["start", "step", "cancel"] }
      }
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    },
    "request": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "required": ["scheduler", "quantum"],
          "properties": {
            "scheduler": {
              "type": "object",
              "required": ["protocol_version", "capabilities"],
              "additionalProperties": false,
              "properties": {
                "protocol_version": { "const": 1 },
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "contains": { "const": "mux-command-execution-v1" },
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            },
            "quantum": {
              "type": "object",
              "required": ["unit", "value"],
              "additionalProperties": false,
              "properties": {
                "unit": { "const": "agent_turn" },
                "value": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            },
            "task": { "type": "object" },
            "token": { "$ref": "#/$defs/token" },
            "reason": { "type": "string" },
            "permission_resolution": { "type": "object" }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "start" } } },
          "then": { "required": ["task"], "not": { "required": ["token"] } },
          "else": { "required": ["token"], "not": { "required": ["task"] } }
        }
      ]
    },
    "response": {
      "allOf": [
        { "$ref": "#/$defs/identity" },
        {
          "type": "object",
          "required": ["classification", "state"],
          "properties": {
            "classification": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000]+$"
            },
            "state": {
              "enum": [
                "ready",
                "yielded",
                "permission_required",
                "complete",
                "cancelled",
                "failed"
              ]
            },
            "token": { "$ref": "#/$defs/token" },
            "exit_code": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "start" } } },
          "then": {
            "properties": { "state": { "enum": ["ready", "failed"] } }
          },
          "else": {
            "if": { "properties": { "operation": { "const": "step" } } },
            "then": {
              "properties": {
                "state": {
                  "enum": [
                    "yielded",
                    "permission_required",
                    "complete",
                    "failed"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "state": { "enum": ["cancelled", "failed"] }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": ["ready", "yielded", "permission_required"]
              }
            }
          },
          "then": {
            "required": ["token"],
            "not": { "required": ["exit_code"] }
          },
          "else": {
            "required": ["exit_code"],
            "not": { "required": ["token"] }
          }
        }
      ]
    }
  }
}
