{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ederevx.example/agent-delegation/permission-v1.schema.json",
  "title": "Agent-neutral permission request or resolution",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "session_id", "operation", "arguments", "reason", "created_at"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "operation": {"enum": ["read", "write", "shell", "network", "process", "external"]},
        "arguments": {"type": "object"},
        "reason": {"type": "string", "minLength": 1},
        "created_at": {"type": "number", "minimum": 0}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "decision"],
      "properties": {
        "schema_version": {"const": 1},
        "request_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["allow", "deny", "handled"]},
        "result": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "handled"}}},
          "then": {"required": ["result"]},
          "else": {"not": {"required": ["result"]}}
        }
      ]
    }
  ]
}
