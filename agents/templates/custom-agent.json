{
  "schema_version": 1,
  "id": "replace-with-agent-id",
  "name": "Replace with agent name",
  "description": "Replace with a concise description of the bounded worker.",
  "native": false,
  "delegation_queue": true,
  "priority": 0,
  "provider": "replace-with-provider",
  "model": "replace-with-model",
  "inference": {
    "thinking": {
      "type": "adaptive"
    },
    "effort": "medium",
    "max_output_tokens": 16384
  },
  "binding": {
    "argv": ["python3", "/absolute/path/to/custom-adapter.py"],
    "max_input_bytes": 1048576,
    "max_output_bytes": 2097152,
    "timeout_seconds": 3600,
    "protocol": "cooperative-v1"
  },
  "capabilities": {
    "functions": ["audit", "batch", "resumable-batch"],
    "runtimes": ["codex", "claude"],
    "platforms": ["linux", "darwin", "windows"],
    "modes": ["read"],
    "workspaces": ["shared"],
    "deliveries": ["json-receipt"]
  },
  "limits": {
    "max_concurrency": 1
  },
  "queue_policy": {
    "strategy": "round_robin",
    "virtual_slots": 4,
    "quantum": {
      "unit": "agent_turn",
      "value": 4
    }
  }
}
