{
  "schema_version": 1,
  "id": "native-codex-bulk",
  "name": "Native Codex bulk worker",
  "description": "Codex-native bounded bulk worker fallback.",
  "native": true,
  "delegation_queue": false,
  "priority": 0,
  "provider": "openai",
  "model": "gpt-5.6-luna",
  "binding": {
    "runtime": "codex",
    "agent_type": "bulk_worker",
    "reasoning_effort": "medium"
  },
  "capabilities": {
    "functions": ["audit", "edit", "batch", "live-worktree"],
    "runtimes": ["codex"],
    "platforms": ["linux", "darwin", "windows"],
    "modes": ["read", "edit"],
    "workspaces": ["shared", "isolated"],
    "deliveries": ["native-agent"]
  },
  "limits": {
    "max_concurrency": 4
  }
}
