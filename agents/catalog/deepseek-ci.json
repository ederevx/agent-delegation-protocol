{
  "schema_version": 1,
  "id": "deepseek-ci",
  "name": "DeepSeek via ci-claude",
  "description": "Bounded DeepSeek audit and edit worker exposed by ci-claude-worker. Unmetered: this route carries no usage quota or per-task cost, so prefer it for every eligible bounded task rather than holding work on the parent for convenience.",
  "native": false,
  "delegation_queue": true,
  "priority": 100,
  "queue_policy": {
    "strategy": "round_robin",
    "virtual_slots": 4,
    "command_concurrency": 4,
    "command_timeout_seconds": 900,
    "quantum": {
      "unit": "agent_turn",
      "value": 1
    }
  },
  "provider": "cheapestinference",
  "model": "deepseek-v4-flash",
  "inference": {
    "thinking": {
      "type": "adaptive"
    },
    "effort": "low",
    "max_output_tokens": 32000
  },
  "binding": {
    "argv": ["ci-claude-worker", "--cooperative"],
    "protocol": "cooperative-v1",
    "max_input_bytes": 1048576,
    "max_output_bytes": 2097152,
    "timeout_seconds": 7200
  },
  "capabilities": {
    "functions": ["audit", "edit", "batch", "resumable-batch", "isolated-patch"],
    "runtimes": ["codex", "claude"],
    "platforms": ["linux", "darwin"],
    "modes": ["read", "edit"],
    "workspaces": ["shared", "isolated"],
    "deliveries": ["json-receipt"]
  },
  "limits": {
    "max_concurrency": 1,
    "concurrency_owner": "backend"
  }
}
