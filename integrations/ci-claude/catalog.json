{
  "schema_version": 2,
  "backends": [
    {
      "id": "ci-claude-session-v2",
      "name": "CI Claude managed session",
      "kind": "session",
      "priority": 100,
      "selector": {
        "runtimes": ["codex", "claude"],
        "platforms": ["linux", "darwin", "windows"],
        "modes": ["read", "edit"],
        "workspaces": ["shared", "isolated"],
        "functions": ["compress"]
      },
      "availability": {
        "commands": [],
        "environment": []
      },
      "execution": {
        "delivery": "managed",
        "deployment": "ci-claude",
        "timeout_seconds": 7200,
        "max_steps": 1000
      }
    }
  ]
}
